# Speech gateway environment. service_ctl.sh and smoke.sh source this file.
# The upstream SGLang-Omni speech stream (services/drama3).
#TTSGW_UPSTREAM_URL=ws://127.0.0.1:30191/v1/audio/speech/stream

# Audio8 instead (services/audio8): a second install, on its own port.
#TTSGW_UPSTREAM=audio8
#TTSGW_PORT=30192
#TTSGW_UPSTREAM_URL=http://127.0.0.1:30193/v1/audio/speech
#TTSGW_VOICES_DIR=/opt/ambient/audio8/voices
