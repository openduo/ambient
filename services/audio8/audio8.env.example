# Audio8 speech server settings for this host. service_ctl.sh and smoke.sh source this file.
#AUDIO8_GPU=0
#AUDIO8_PORT=30193
#AUDIO8_HOST=127.0.0.1
#AUDIO8_MODEL_DIR=/opt/ambient/audio8/models/Audio8-TTS-Realistic-0.6b
#AUDIO8_VOICES_DIR=/opt/ambient/audio8/voices
#AUDIO8_CUDA_HOME=/usr/local/cuda
# Attention backend: fa3 (the default) for sm_90; sm_120 cards need flashinfer.
#AUDIO8_TTS_ATTENTION_BACKEND=fa3
