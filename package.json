{
  "name": "ambient",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint:types": "tsc -p packages/ambient-protocol/tsconfig.json --noEmit && pnpm --filter @openduo/channel-ambient run lint:types && pnpm --filter @openduo/cerebellum run lint:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @openduo/ambient-protocol run build && pnpm --filter @openduo/channel-ambient run build:plugin",
    "lint": "eslint . && node scripts/license-header.mjs --check",
    "license:check": "node scripts/license-header.mjs --check",
    "license:fix": "node scripts/license-header.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write",
      "node scripts/license-header.mjs --check"
    ],
    "*.{sh,py,css}": [
      "node scripts/license-header.mjs --check"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
